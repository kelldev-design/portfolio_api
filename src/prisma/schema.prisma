datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PortfolioItem {
  id             Int                  @id @default(autoincrement())
  description    String
  homeImage      ProjectImage         @relation(name: "HomeImageId", fields: [homeImageId], references: [id])
  primaryImage   ProjectImage         @relation(name: "PrimaryImageId", fields: [primaryImageId], references: [id])
  projectId      String               @unique
  name           String               @unique
  /// Position on the site, lowest first. Set by reorderPortfolioItems.
  sortOrder      Int                  @default(0)
  projectImages  PortfolioItemImage[]
  categories     Category[]
  links          Link[]
  products       Product[]
  homeImageId    Int
  primaryImageId Int
}

model Link {
  id            Int             @id @default(autoincrement())
  isInternal    Boolean
  label         String
  url           String          @unique
  type          LinkType        @relation(fields: [linkTypeId], references: [id])
  PortfolioItem PortfolioItem[]
  linkTypeId    Int
}

model LinkType {
  id   Int    @id @default(autoincrement())
  name String @unique
  Link Link[]
}

model ProjectImage {
  id                          Int                  @id @default(autoincrement())
  imageUrl                    String               @unique
  primaryImagesPortfolioItems PortfolioItem[]      @relation("PrimaryImageId")
  homeImagesPortfolioItems    PortfolioItem[]      @relation("HomeImageId")
  portfolioItems              PortfolioItemImage[]
}

/// A project image's place in one portfolio item's gallery. An explicit join, rather than
/// an implicit many-to-many, so that each item keeps its own image order.
model PortfolioItemImage {
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  portfolioItemId Int
  projectImage    ProjectImage  @relation(fields: [projectImageId], references: [id], onDelete: Cascade)
  projectImageId  Int
  position        Int

  @@id([portfolioItemId, projectImageId])
  @@index([projectImageId])
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  PortfolioItem PortfolioItem[]
}

model Product {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  PortfolioItem PortfolioItem[]
}

model MarketSeries {
  id            Int                 @id @default(autoincrement())
  fredId        String              @unique
  label         String
  category      String
  unit          String
  lastFetchedAt DateTime?
  observations  MarketObservation[]
}

model MarketObservation {
  id       Int          @id @default(autoincrement())
  series   MarketSeries @relation(fields: [seriesId], references: [id])
  seriesId Int
  date     DateTime
  value    Float

  @@unique([seriesId, date])
  @@index([seriesId, date])
}
