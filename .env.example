# Copy to .env for local development. In production this file is written by
# deploy/bootstrap.sh from the `portfolio-api/env` secret in Secrets Manager.

# SQLite. Local dev uses a file in the checkout; production points at the
# persistent data volume (file:/var/lib/portfolio-api/prod.db).
DATABASE_URL="file:./dev.db"

KELLEGHAN_DESIGN_CLIENT_URL="http://localhost:5173"
KELLDEV_CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Admin login for the portfolio admin UI at kelldev.design/admin. All three are
# required for the `login` mutation to work; if any is missing every login fails.
# Don't fill these in by hand. Run `deploy/set-admin-credentials.sh --local`: it asks
# for the password, stores only its bcrypt hash and generates JWT_SECRET. Without
# --local it updates the production secret instead. See docs/AUTH.md.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
JWT_SECRET=""

# Required by the market rates layer (src/services/fred.ts).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""

# Optional. How long a series stays fresh once it holds the newest print FRED is
# expected to have published (default 12), and how often it is rechecked while
# that print is still missing (default 1). See docs/DEPLOY.md.
FRED_TTL_HOURS=""
FRED_POLL_TTL_HOURS=""
