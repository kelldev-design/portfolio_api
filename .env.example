# Local development: copy to .env. In production, deploy/bootstrap.sh writes .env
# from the `portfolio-api/env` secret in Secrets Manager.

NODE_ENV="development"

# SQLite file, created by `npm run start:dev`. Production uses the data volume
# (file:/var/lib/portfolio-api/prod.db).
DATABASE_URL="file:./dev.db"

# Origins allowed through CORS (src/index.ts). In production these are the two
# site domains; locally both point at the portfolio_site dev server (port 3000).
KELLDEV_CLIENT_URL="http://localhost:3000"
KELLEGHAN_DESIGN_CLIENT_URL="http://localhost:3000"

# --- Market rates (src/services/fred.ts) --------------------------------------
# Required. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""
# Optional. Hours a series stays fresh once it has the newest expected print
# (default 12), and how often it is rechecked while that print is missing
# (default 1). See docs/DEPLOY.md.
# FRED_TTL_HOURS=12
# FRED_POLL_TTL_HOURS=1

# --- Admin login (/admin): optional locally -----------------------------------
# Needed only to log in to the admin UI; if any of the three is missing, every
# login fails. Don't fill these in by hand: run
# `deploy/set-admin-credentials.sh --local`, which stores only the password's
# bcrypt hash and generates JWT_SECRET. Without --local it changes the
# production secret instead. See docs/AUTH.md.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
JWT_SECRET=""
